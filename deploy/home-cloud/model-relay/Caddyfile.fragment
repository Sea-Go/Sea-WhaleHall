# Insert these handlers inside the existing
# model.sea-ridethewindbreakthewaves.xyz site block, ABOVE a generic /v1/*
# model handler. Keep the existing /v1/activity/analyze handler unchanged.
#
# The exact route split is intentional:
#   /v1/activity/analyze  -> existing activity Worker (unchanged)
#   POST /v1/activity/completions -> this native relay; client-owned prompt/output
#   /v1/auth/..., /v1/chat/..., /v1/agent/..., /v1/devices/... and /api/v1/agent/...
#       -> DataCenter data origin; never route them through the model origin

@whalehall_model_relay {
	method POST
	path /v1/activity/completions
}
handle @whalehall_model_relay {
	reverse_proxy 127.0.0.1:8787
}

@whalehall_model_relay_invalid_method {
	not method POST
	path /v1/activity/completions
}
respond @whalehall_model_relay_invalid_method 405

@whalehall_datacenter_paths {
	path /v1/auth/* /v1/chat/* /v1/agent/* /v1/devices/* /api/v1/agent/*
}
respond @whalehall_datacenter_paths 404
