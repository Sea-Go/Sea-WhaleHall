# Owner-only file: /etc/whalehall/model-relay.env (mode 0600).
# The native relay has a fixed 127.0.0.1:8787 listener and fixed CPU-only
# 127.0.0.1:11437 qwen3:1.7b upstream. Do not add provider URLs or keys here.
WHALEHALL_RELAY_USERS_FILE=/etc/whalehall/model-relay-users.json
WHALEHALL_RELAY_DATA_DIR=/var/lib/whalehall-model-relay
WHALEHALL_CHAT_REQUESTS_PER_MINUTE=60
WHALEHALL_REFLECTION_REQUESTS_PER_MINUTE=20
WHALEHALL_LOGIN_ATTEMPTS_PER_MINUTE=10
