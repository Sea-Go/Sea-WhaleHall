{
	"name": "sea-whalehall",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently -k -n vite,electrobun \"vite --host 127.0.0.1 --port 5173\" \"electrobun dev --watch\"",
		"build:agent-host": "bun run scripts/build-agent-host.ts",
		"build:views": "vite build && bun run scripts/stage-view-assets.ts",
		"build:native": "bun run scripts/build-native.ts",
		"build:canary": "electrobun build --env=canary",
		"build:stable": "electrobun build --env=stable",
		"setup:macos-signing": "bun run scripts/setup-macos-signing.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"lint:changed": "biome check --changed --since=origin/main --no-errors-on-unmatched --reporter=github",
		"test:sensors:ci": "bun test tests/native-integration.test.ts",
		"test:credential-helper": "cargo test --locked --manifest-path native/credential-helper/Cargo.toml --all-targets",
		"test:rust": "cargo test --locked --manifest-path native/local-host/Cargo.toml --workspace && bun run test:credential-helper",
		"check:credential-helper": "cargo fmt --all --check --manifest-path native/credential-helper/Cargo.toml && cargo clippy --locked --manifest-path native/credential-helper/Cargo.toml --all-targets -- -D warnings && bun run test:credential-helper",
		"check:rust": "cargo fmt --all --check --manifest-path native/local-host/Cargo.toml && cargo clippy --locked --manifest-path native/local-host/Cargo.toml --workspace --all-targets -- -D warnings && cargo test --locked --manifest-path native/local-host/Cargo.toml --workspace && bun run check:credential-helper",
		"check": "bun run typecheck && bun run check:rust && bun test"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "3.0.39",
		"@fullcalendar/react": "7.0.2",
		"@fullcalendar/rrule": "7.0.2",
		"@mastra/core": "1.63.0",
		"@mastra/memory": "1.28.0",
		"electrobun": "1.18.1",
		"lucide-react": "1.34.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"rrule": "2.8.1",
		"temporal-polyfill": "1.0.4",
		"zod": "4.4.3"
	},
	"patchedDependencies": {
		"electrobun@1.18.1": "patches/electrobun@1.18.1.patch"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@happy-dom/global-registrator": "20.11.12",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.6",
		"@types/bun": "1.4.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@types/three": "0.185.4",
		"@vitejs/plugin-react": "6.1.1",
		"concurrently": "10.0.5",
		"happy-dom": "20.11.12",
		"typescript": "7.0.2",
		"vite": "8.2.2"
	}
}
