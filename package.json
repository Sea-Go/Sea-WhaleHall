{
	"name": "sea-whalehall",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently -k -n vite,electrobun \"vite --host 127.0.0.1 --port 5173\" \"electrobun dev --watch\"",
		"build:views": "vite build && bun run scripts/stage-view-assets.ts",
		"build:native": "bun run scripts/build-native.ts",
		"build:canary": "electrobun build --env=canary",
		"setup:macos-signing": "bun run scripts/setup-macos-signing.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"lint:changed": "biome check --changed --since=origin/main --no-errors-on-unmatched --reporter=github",
		"test:sensors:ci": "bun test tests/native-integration.test.ts",
		"test:rust": "cargo test --locked --manifest-path whalehall-local/Cargo.toml --workspace",
		"check:rust": "cargo fmt --all --check --manifest-path whalehall-local/Cargo.toml && cargo clippy --locked --manifest-path whalehall-local/Cargo.toml --workspace --all-targets -- -D warnings && cargo test --locked --manifest-path whalehall-local/Cargo.toml --workspace",
		"check": "bun run typecheck && bun run check:rust && bun test"
	},
	"dependencies": {
		"@fullcalendar/react": "7.0.2",
		"@fullcalendar/rrule": "7.0.2",
		"electrobun": "1.18.1",
		"lucide-react": "1.27.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"rrule": "2.8.1",
		"temporal-polyfill": "1.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@types/bun": "1.3.8",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@types/three": "0.185.1",
		"@vitejs/plugin-react": "6.0.3",
		"concurrently": "10.0.3",
		"typescript": "7.0.2",
		"vite": "8.1.5"
	}
}
