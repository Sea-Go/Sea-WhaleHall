{
	"name": "sea-whalehall",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently -k -n vite,electrobun \"vite --host 127.0.0.1 --port 5173\" \"electrobun dev --watch\"",
		"build:agent-host": "bun run scripts/build-agent-host.ts",
		"build:model-relay": "tsc -p services/model-relay/tsconfig.json",
		"provision:relay-owner": "bun run scripts/provision-relay-owner.ts",
		"build:views": "vite build && bun run scripts/stage-view-assets.ts",
		"build:native": "bun run scripts/build-native.ts",
		"build:canary": "electrobun build --env=canary",
		"setup:macos-signing": "bun run scripts/setup-macos-signing.ts",
		"start:model-relay": "node build/model-relay/main.js",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"lint:changed": "biome check --changed --since=origin/main --no-errors-on-unmatched --reporter=github",
		"test:sensors:ci": "bun test tests/native-integration.test.ts",
		"test:credential-helper": "cargo test --locked --manifest-path whalehall-credential-helper/Cargo.toml --all-targets",
		"test:rust": "cargo test --locked --manifest-path whalehall-local/Cargo.toml --workspace && bun run test:credential-helper",
		"check:credential-helper": "cargo fmt --all --check --manifest-path whalehall-credential-helper/Cargo.toml && cargo clippy --locked --manifest-path whalehall-credential-helper/Cargo.toml --all-targets -- -D warnings && bun run test:credential-helper",
		"check:rust": "cargo fmt --all --check --manifest-path whalehall-local/Cargo.toml && cargo clippy --locked --manifest-path whalehall-local/Cargo.toml --workspace --all-targets -- -D warnings && cargo test --locked --manifest-path whalehall-local/Cargo.toml --workspace && bun run check:credential-helper",
		"check": "bun run typecheck && bun run check:rust && bun test"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "3.0.20",
		"@fullcalendar/react": "7.0.2",
		"@fullcalendar/rrule": "7.0.2",
		"@mastra/core": "1.55.0",
		"@mastra/memory": "1.24.0",
		"electrobun": "1.18.1",
		"lucide-react": "1.27.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"rrule": "2.8.1",
		"temporal-polyfill": "1.0.2",
		"zod": "4.1.12"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@happy-dom/global-registrator": "20.11.1",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.1",
		"@types/bun": "1.3.8",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@types/three": "0.185.1",
		"@vitejs/plugin-react": "6.0.3",
		"concurrently": "10.0.3",
		"happy-dom": "20.11.1",
		"typescript": "7.0.2",
		"vite": "8.1.5"
	}
}
