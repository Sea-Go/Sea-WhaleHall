{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whalehall.local/schemas/event-window.v1.schema.json",
  "title": "WhaleHall EventWindow v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "windowId",
    "participantId",
    "deviceId",
    "projectGoalId",
    "sessionId",
    "sessionDate",
    "goal",
    "triggerReason",
    "startedAtMs",
    "endedAtMs",
    "events",
    "contextOnly",
    "modelInput"
  ],
  "properties": {
    "schemaVersion": {
      "const": "event-window.v1"
    },
    "windowId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "participantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "projectGoalId": {
      "type": ["string", "null"],
      "maxLength": 160
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "sessionDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "goal": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["goalId", "version", "text"],
          "properties": {
            "goalId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "version": {
              "type": "integer",
              "minimum": 0
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        }
      ]
    },
    "triggerReason": {
      "enum": [
        "event_count",
        "max_wait",
        "goal_boundary",
        "presence_boundary"
      ]
    },
    "startedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "endedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "contextOnly": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "modelInput": {
      "type": "string",
      "minLength": 1,
      "maxLength": 131072
    },
    "metadata": {
      "type": "object"
    },
    "gold": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/gold"
        }
      ]
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "kind",
        "source",
        "occurredAtMs",
        "summary"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "occurredAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "attributes": {
          "type": "object"
        }
      }
    },
    "gold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity", "goalRelevance"],
      "properties": {
        "activity": {
          "enum": [
            "development",
            "writing",
            "research",
            "communication",
            "planning",
            "data_work",
            "media",
            "gaming",
            "system_file_ops",
            "commerce",
            "idle_transition",
            "other_unknown"
          ]
        },
        "goalRelevance": {
          "type": ["string", "null"],
          "enum": [
            "direct",
            "supporting",
            "unrelated",
            "uncertain",
            null
          ]
        }
      }
    }
  }
}
