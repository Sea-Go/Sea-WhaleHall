# Reflection, Timeline v2, local Qwen, and ModernBERT endpoints are configured
# through the packaged config.yaml (generated from config.template.yaml), not
# through this file. These variables belong only to the local Mastra relay
# boundary and the separately deployed relay service.

# Desktop: the current demo@whalehall.local / whalehall experience account is
# validated locally and has no bearer. Formal remote auth is deferred, so model
# relay is explicitly unavailable in this mode; this URL is reserved for that
# future integration and does not enable access by itself.
WHALEHALL_RELAY_URL=https://relay.example.com/
WHALEHALL_MODEL_ID=gpt-4.1-mini

# Remote model-relay deployment only. Never put provider credentials in a
# desktop .env, packaged resource, Renderer, or Mastra Sidecar environment.
WHALEHALL_PROVIDER_CHAT_COMPLETIONS_URL=https://api.provider.example/v1/chat/completions
WHALEHALL_PROVIDER_API_KEY=replace-on-the-remote-host-only
WHALEHALL_ALLOWED_MODELS=gpt-4.1-mini
WHALEHALL_RELAY_USERS_FILE=/private/whalehall/users.json
WHALEHALL_RELAY_DATA_DIR=/private/whalehall/data
