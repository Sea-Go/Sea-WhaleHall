{
  "schemaVersion": "whalehall-vscode-spool-manifest.v1",
  "protocolVersion": "whalehall.vscode-spool.v1",
  "recordSchemaVersion": "whalehall-vscode-edit.v1",
  "encoding": "utf-8",
  "framing": "jsonl",
  "publishProtocol": "same-directory-temp-fsync-rename",
  "segmentPattern": "^segment-[0-9]{13}-[0-9a-f]{32}\\.jsonl$",
  "temporaryPattern": "^\\.tmp-[0-9a-f-]+$",
  "limits": {
    "maxEventLineBytes": 65536,
    "maxEventsPerSegment": 128,
    "maxSegmentBytes": 262144,
    "maxSpoolSegments": 4096,
    "maxSpoolBytes": 67108864
  }
}
